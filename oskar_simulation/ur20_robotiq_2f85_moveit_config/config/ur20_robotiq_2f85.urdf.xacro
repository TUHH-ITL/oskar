<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur20_robotiq_2f85">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ur20_robotiq_2f85 urdf file -->
    <xacro:include filename="$(find ur20_robotiq_2f85_combined)/urdf/ur20_robotiq_2f85_combined.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="ur20_robotiq_2f85.ros2_control.xacro" />


    <xacro:ur20_robotiq_2f85_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
