Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Line Style:
        Value: Lines
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.4
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Update Interval: 0
      Tree:
        {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Flower map
      Enabled: true
      Topic:
        Value: /orchard/landmark_markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Namespaces:
        {}
    - Class: rviz_default_plugins/MarkerArray
      Name: Evaluation
      Enabled: true
      Topic:
        Value: /orchard/eval_markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Namespaces:
        {}
    - Class: rviz_default_plugins/Image
      Name: Detector overlay
      Enabled: true
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Value: /perception/debug_image
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Image
      Name: Wrist camera
      Enabled: false
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Value: /wrist_cam/left/image_raw
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 9
      Focal Point:
        X: 1.0
        Y: 3.5
        Z: 2.0
      Pitch: 0.25
      Yaw: 1.6
      Target Frame: map
      Value: Orbit (rviz)
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
